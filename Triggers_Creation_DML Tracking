/* =========================================================================
   TRIGGER 1: Sequence_Channel  -->  Sequence_Channel_Curated
   Columns: ChannelId (IDENTITY, PK), InjectionId, ChannelName, DetectorType,
            Wavelength, DataRate
   ========================================================================= */
IF OBJECT_ID('dbo.trg_Sequence_Channel_DML', 'TR') IS NOT NULL
    DROP TRIGGER dbo.trg_Sequence_Channel_DML;
GO

CREATE TRIGGER dbo.trg_Sequence_Channel_DML
ON [dbo].[Sequence_Channel]
AFTER INSERT, UPDATE, DELETE
AS
BEGIN
    SET NOCOUNT ON;

    -- ---------- INSERT ----------
    IF EXISTS (SELECT 1 FROM INSERTED) AND NOT EXISTS (SELECT 1 FROM DELETED)
    BEGIN
        SET IDENTITY_INSERT [dbo].[Sequence_Channel_Curated] ON;

        INSERT INTO [dbo].[Sequence_Channel_Curated]
            (ChannelId, InjectionId, ChannelName, DetectorType, Wavelength, DataRate)
        SELECT
            I.ChannelId, I.InjectionId, I.ChannelName, I.DetectorType, I.Wavelength, I.DataRate
        FROM INSERTED I
        LEFT JOIN DELETED D ON I.ChannelId = D.ChannelId
        WHERE D.ChannelId IS NULL;

        SET IDENTITY_INSERT [dbo].[Sequence_Channel_Curated] OFF;
    END

    -- ---------- UPDATE ----------
    IF EXISTS (SELECT 1 FROM INSERTED) AND EXISTS (SELECT 1 FROM DELETED)
    BEGIN
        UPDATE T
        SET
            T.InjectionId  = I.InjectionId,
            T.ChannelName  = I.ChannelName,
            T.DetectorType = I.DetectorType,
            T.Wavelength   = I.Wavelength,
            T.DataRate     = I.DataRate
        FROM [dbo].[Sequence_Channel_Curated] T
        INNER JOIN INSERTED I ON T.ChannelId = I.ChannelId
        INNER JOIN DELETED D  ON I.ChannelId = D.ChannelId;
    END

    -- ---------- DELETE ----------
    IF NOT EXISTS (SELECT 1 FROM INSERTED) AND EXISTS (SELECT 1 FROM DELETED)
    BEGIN
        DELETE T
        FROM [dbo].[Sequence_Channel_Curated] T
        INNER JOIN DELETED D ON T.ChannelId = D.ChannelId;
    END
END;
GO


